# =============================================================================
# CryptoScope AI — Environment Configuration Template
# =============================================================================

# Server Port
PORT=3000

# Node Environment ('development' or 'production')
NODE_ENV=production

# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.jpegjln.mongodb.net/cryptoscope?appName=Cluster0

# JSON Web Token Secret Key for Session Authentication (Minimum 32 characters in production)
JWT_SECRET=your_super_secret_jwt_encryption_key_at_least_32_chars

# Strict CORS Allowed Origins (Comma-separated list of trusted frontend domains)
ALLOWED_ORIGINS=http://localhost:3000

# Optional: GNews API Key for additional live crypto news search
GNEWS_API_KEY=your_optional_gnews_api_key

# Optional: Dedicated Bitcoin RPC or Mempool API Endpoint (Default: https://mempool.space/api)
MEMPOOL_API_BASE=https://mempool.space/api

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# =============================================================================
# Gmail SMTP Email Delivery Configuration (Password Reset)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM=CRYPTOSCOPE AI <your_gmail_address@gmail.com>
FRONTEND_URL=http://localhost:3000

